{%- liquid
  assign current_product = product
  assign current_variant = current_product.selected_or_first_available_variant
  assign product_form_id = 'WavesHero-ProductForm-' | append: section.id

  assign can_add_to_cart = false
  assign add_to_cart_text = 'products.product.unavailable' | t
  if current_variant
    if current_variant.available
      assign can_add_to_cart = true
      assign add_to_cart_text = 'products.product.add_to_cart' | t
    elsif current_variant.inventory_quantity <= 0
      assign add_to_cart_text = 'products.product.sold_out' | t
    endif
  endif
-%}

{% render 'buy-buttons-styles' %}

<section class="waves-hero-product" id="waves-hero-product">

  <!-- ── Galería ── -->
  <div class="whp-gallery">
    {%- if current_product.images.size > 0 -%}
      <div class="whp-gallery__track">
        {%- for img in current_product.images -%}
          <div class="whp-gallery__slide{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}">
            {{
              img
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                alt: img.alt | default: current_product.title,
                class: 'whp-gallery__img'
            }}
          </div>
        {%- endfor -%}
      </div>
      {%- if current_product.images.size > 1 -%}
        <div class="whp-gallery__thumbs">
          {%- for img in current_product.images -%}
            <button class="whp-gallery__thumb{% if forloop.first %} active{% endif %}"
              data-index="{{ forloop.index0 }}" type="button" aria-label="Imagen {{ forloop.index }}">
              {{ img | image_url: width: 120 | image_tag: loading: 'lazy', alt: img.alt }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="whp-gallery__placeholder">
        <div class="whp-gallery__placeholder-icon">🌊</div>
      </div>
    {%- endif -%}
  </div>

  <!-- ── Panel de compra ── -->
  <div class="whp-panel">
    <div class="whp-panel__inner">

      {%- if section.settings.badge != blank -%}
        <p class="whp-badge">{{ section.settings.badge }}</p>
      {%- endif -%}

      <h1 class="whp-title">{{ current_product.title }}</h1>

      <div class="whp-price" id="whp-price-{{ section.id }}">
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="whp-price__original">{{ current_variant.compare_at_price | money }}</span>
          <span class="whp-price__sale">{{ current_variant.price | money }}</span>
          {%- assign savings = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
          <span class="whp-price__badge">-{{ savings }}%</span>
        {%- else -%}
          <span class="whp-price__current">{{ current_variant.price | money }}</span>
        {%- endif -%}
      </div>

      {%- if section.settings.benefits != blank -%}
        <div class="whp-benefits">
          {%- assign benefit_list = section.settings.benefits | split: '|' -%}
          {%- for benefit in benefit_list -%}
            <span class="whp-benefit">{{ benefit | strip }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="whp-divider"></div>

      {%- unless current_product.has_only_default_variant -%}
        <div class="whp-variants">
          {%- for option in current_product.options_with_values -%}
            <div class="whp-variant-group">
              <label class="whp-variant-label">{{ option.name }}</label>
              <div class="whp-variant-btns">
                {%- for value in option.values -%}
                  <label class="whp-variant-btn{% if value.selected %} selected{% endif %}{% unless value.available %} unavailable{% endunless %}">
                    <input type="radio" name="options[{{ option.name | escape }}]"
                      value="{{ value | escape }}" {% if value.selected %}checked{% endif %}
                      {% unless value.available %}disabled{% endunless %}>
                    {{ value | escape }}
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      <product-form-component
        data-section-id="{{ section.id }}"
        data-product-id="{{ current_product.id }}"
        data-product-url="{{ current_product.url }}"
        on:submit="/handleSubmit"
        data-quantity-default="1"
        data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
      >
        <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
        {%- form 'product', current_product, id: product_form_id, data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" ref="variantId" value="{{ current_variant.id }}">
          <div class="whp-form-actions" ref="productFormButtons">
            <div class="whp-form-error hidden" ref="addToCartTextError">
              <span ref="addToCartErrorMessage"></span>
            </div>
            <add-to-cart-component
              ref="addToCartButtonContainer"
              data-product-variant-media="{{ current_variant.featured_media.preview_image | image_url: width: 100 }}"
              data-add-to-cart-animation="{{ settings.add_to_cart_animation }}"
            >
              <button type="submit" name="add" ref="addToCartButton" class="whp-cta-btn"
                {% unless can_add_to_cart %}disabled{% endunless %}>
                <span class="add-to-cart-text">
                  {%- if can_add_to_cart -%}
                    <span aria-hidden="true" class="svg-wrapper add-to-cart-icon">
                      {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
                    </span>
                  {%- endif -%}
                  <span class="add-to-cart-text__content">
                    <span><span>{{ add_to_cart_text }}</span></span>
                  </span>
                </span>
                <span class="add-to-cart__added">
                  <span class="svg-wrapper add-to-cart__added-icon">
                    {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
                  </span>
                </span>
              </button>
            </add-to-cart-component>
          </div>
        {%- endform -%}
      </product-form-component>

      {%- if section.settings.guarantees != blank -%}
        <div class="whp-guarantees">
          {%- assign guarantee_list = section.settings.guarantees | split: '|' -%}
          {%- for g in guarantee_list -%}
            <div class="whp-guarantee">{{ g | strip }}</div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>

  <!-- Scroll hint -->
  <div class="whp-scroll-hint" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
      <path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

</section>

<!-- Wave separator -->
<div class="whp-wave-sep" aria-hidden="true">
  <svg viewBox="0 0 1440 72" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0,40 C360,80 1080,0 1440,40 L1440,72 L0,72 Z" fill="var(--color-background, #ffffff)"/>
  </svg>
</div>

<style>
/* ══════════════════════════════════════════
   WAVES PRODUCT HERO
   ══════════════════════════════════════════ */

/* Forzar que el wrapper de Shopify no limite la sección */
.shopify-section:has(.waves-hero-product) {
  display: block;
  height: 96vh;
  min-height: 600px;
}

.waves-hero-product {
  display: grid;
  grid-template-columns: 55% 45%;
  /* Toma el 100% del wrapper de Shopify */
  height: 100%;
  width: 100%;
  position: relative;
  background: #0B1F3A;
  overflow: hidden;
  /* Anular cualquier padding/margin del tema */
  margin: 0 !important;
}

/* ── Galería (columna izquierda) ── */
.whp-gallery {
  position: relative;
  overflow: hidden;
  background: #07172C;
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* Grid stack — todas las slides se superponen sin cambiar position */
.whp-gallery__track {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-areas: 'slide';
}
.whp-gallery__slide {
  grid-area: slide;
  opacity: 0;
  transition: opacity 0.5s ease;
  pointer-events: none;
}
.whp-gallery__slide.active {
  opacity: 1;
  pointer-events: auto;
}
.whp-gallery__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  display: block;
  background: #07172C;
}

/* Thumbnails */
.whp-gallery__thumbs {
  display: flex;
  gap: 6px;
  padding: 10px 12px;
  overflow-x: auto;
  background: rgba(0,0,0,0.35);
  flex-shrink: 0;
  scrollbar-width: thin;
  scrollbar-color: rgba(255,255,255,0.2) transparent;
}
.whp-gallery__thumb {
  flex-shrink: 0;
  width: 56px;
  height: 56px;
  border-radius: 6px;
  overflow: hidden;
  cursor: pointer;
  border: 2px solid transparent;
  padding: 0;
  background: none;
  opacity: 0.55;
  transition: all 0.2s;
}
.whp-gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }
.whp-gallery__thumb.active,
.whp-gallery__thumb:hover { border-color: #4FC3F7; opacity: 1; }

/* Placeholder sin imagen */
.whp-gallery__placeholder {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #07172C 0%, #0d2a4e 100%);
}
.whp-gallery__placeholder-icon {
  font-size: 4rem;
  opacity: 0.3;
}

/* ── Panel compra (columna derecha) ── */
.whp-panel {
  height: 100%;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: linear-gradient(160deg, #0B1F3A 0%, #0d2545 100%);
  border-left: 1px solid rgba(255,255,255,0.05);
  scrollbar-width: thin;
  scrollbar-color: rgba(255,255,255,0.1) transparent;
}
.whp-panel__inner {
  padding: 48px 44px;
  max-width: 480px;
  width: 100%;
}

/* Badge */
.whp-badge {
  display: inline-block;
  background: rgba(79,195,247,0.12);
  border: 1px solid rgba(79,195,247,0.3);
  color: #4FC3F7;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 100px;
  margin-bottom: 16px;
}

/* Título */
.whp-title {
  font-size: clamp(1.6rem, 2.5vw, 2.4rem);
  font-weight: 800;
  color: #ffffff;
  line-height: 1.15;
  margin: 0 0 14px;
  font-family: var(--font-primary--family, inherit);
}

/* Precio */
.whp-price {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
  flex-wrap: wrap;
}
.whp-price__current { font-size: 1.75rem; font-weight: 700; color: #fff; }
.whp-price__sale    { font-size: 1.75rem; font-weight: 700; color: #4FC3F7; }
.whp-price__original{ font-size: 1rem; color: rgba(255,255,255,0.4); text-decoration: line-through; }
.whp-price__badge   { background: #1B5E20; color: #A5D6A7; font-size: 0.73rem; font-weight: 700; padding: 3px 8px; border-radius: 6px; }

/* Beneficios pills */
.whp-benefits {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-bottom: 18px;
}
.whp-benefit {
  background: rgba(255,255,255,0.07);
  color: rgba(255,255,255,0.8);
  font-size: 0.78rem;
  font-weight: 500;
  padding: 5px 11px;
  border-radius: 20px;
  border: 1px solid rgba(255,255,255,0.1);
}

/* Divider */
.whp-divider {
  height: 1px;
  background: rgba(255,255,255,0.07);
  margin-bottom: 20px;
}

/* Variantes */
.whp-variants { margin-bottom: 20px; }
.whp-variant-group { margin-bottom: 12px; }
.whp-variant-label {
  display: block;
  font-size: 0.78rem;
  font-weight: 600;
  color: rgba(255,255,255,0.55);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 7px;
}
.whp-variant-btns { display: flex; flex-wrap: wrap; gap: 7px; }
.whp-variant-btn {
  cursor: pointer;
  padding: 7px 14px;
  border-radius: 7px;
  border: 1.5px solid rgba(255,255,255,0.18);
  color: rgba(255,255,255,0.75);
  font-size: 0.85rem;
  font-weight: 500;
  transition: all 0.15s;
  user-select: none;
}
.whp-variant-btn input { display: none; }
.whp-variant-btn.selected,
.whp-variant-btn:hover { border-color: #4FC3F7; color: #4FC3F7; background: rgba(79,195,247,0.1); }
.whp-variant-btn.unavailable { opacity: 0.3; cursor: not-allowed; }

/* Form */
.whp-form-actions { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
.whp-form-error { color: #ef5350; font-size: 0.83rem; }
.whp-form-error.hidden { display: none; }

/* Botón CTA */
.whp-cta-btn {
  width: 100%;
  padding: 17px 28px;
  background: linear-gradient(135deg, #1565C0, #0D47A1);
  color: #fff;
  font-size: 1rem;
  font-weight: 700;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  transition: all 0.2s;
  letter-spacing: 0.02em;
  box-shadow: 0 4px 20px rgba(21,101,192,0.4);
}
.whp-cta-btn:hover:not(:disabled) {
  background: linear-gradient(135deg, #1E88E5, #1565C0);
  transform: translateY(-1px);
  box-shadow: 0 8px 28px rgba(21,101,192,0.55);
}
.whp-cta-btn:disabled {
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.35);
  cursor: not-allowed;
  box-shadow: none;
}
.whp-cta-btn .add-to-cart-text { display: flex; align-items: center; gap: 8px; }
.whp-cta-btn .add-to-cart-icon svg { width: 18px; height: 18px; fill: currentColor; }
.whp-cta-btn .add-to-cart__added { display: none; }

/* Guarantees */
.whp-guarantees {
  display: flex;
  flex-direction: column;
  gap: 7px;
  padding: 12px 14px;
  background: rgba(255,255,255,0.04);
  border-radius: 8px;
  border: 1px solid rgba(255,255,255,0.06);
}
.whp-guarantee {
  font-size: 0.8rem;
  color: rgba(255,255,255,0.6);
}

/* Scroll hint */
.whp-scroll-hint {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  color: rgba(255,255,255,0.25);
  animation: whp-bounce 2.2s ease-in-out infinite;
  pointer-events: none;
  z-index: 5;
}
@keyframes whp-bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50%       { transform: translateX(-50%) translateY(7px); }
}

/* Wave separator */
.whp-wave-sep {
  display: block;
  background: #0B1F3A;
  line-height: 0;
  margin-top: -1px;
}
.whp-wave-sep svg { width: 100%; height: 64px; display: block; }

/* ── Responsive ── */
@media (max-width: 900px) {
  .shopify-section:has(.waves-hero-product) {
    height: auto;
    min-height: auto;
  }
  .waves-hero-product {
    grid-template-columns: 1fr;
    height: auto;
  }
  .whp-gallery {
    height: 56vw;
    min-height: 280px;
    max-height: 460px;
  }
  .whp-panel { height: auto; }
  .whp-panel__inner { padding: 28px 20px 40px; max-width: 100%; }
  .whp-scroll-hint { display: none; }
  .whp-wave-sep svg { height: 40px; }
}
@media (max-width: 480px) {
  .whp-title { font-size: 1.5rem; }
  .whp-gallery { height: 65vw; }
}

/* Visually hidden */
.waves-hero-product .visually-hidden {
  position: absolute; width: 1px; height: 1px;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap;
}
</style>

<script>
(function(){
  const section = document.getElementById('waves-hero-product');
  if(!section) return;

  const thumbs = section.querySelectorAll('.whp-gallery__thumb');
  const slides = section.querySelectorAll('.whp-gallery__slide');

  function setSlide(idx){
    slides.forEach((s,i) => s.classList.toggle('active', i===idx));
    thumbs.forEach((t,i) => t.classList.toggle('active', i===idx));
  }
  thumbs.forEach(btn => btn.addEventListener('click', () => setSlide(+btn.dataset.index)));

  {% if current_product.variants.size > 1 %}
  const variants = {{ current_product.variants | json }};
  const variantInput = section.querySelector('[ref="variantId"]');
  const priceEl = section.querySelector('#whp-price-{{ section.id }}');
  const variantBtns = section.querySelectorAll('.whp-variant-btn');

  variantBtns.forEach(btn => {
    btn.querySelector('input')?.addEventListener('change', () => {
      variantBtns.forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      syncVariant();
    });
  });

  function syncVariant(){
    const checked = {};
    section.querySelectorAll('.whp-variants input[type="radio"]:checked').forEach(r => {
      const key = r.name.replace(/^options\[(.+)\]$/, '$1');
      checked[key] = r.value;
    });
    const match = variants.find(v =>
      v.options.every((opt, i) => opt === Object.values(checked)[i])
    );
    if(!match) return;
    if(variantInput) variantInput.value = match.id;
    const btn = section.querySelector('.whp-cta-btn');
    if(btn) btn.disabled = !match.available;
    if(priceEl && match.price){
      const fmt = n => (n/100).toLocaleString('es-AR', {style:'currency', currency:'ARS', minimumFractionDigits:2});
      if(match.compare_at_price && match.compare_at_price > match.price){
        const pct = Math.round((match.compare_at_price - match.price)*100/match.compare_at_price);
        priceEl.innerHTML = `<span class="whp-price__original">${fmt(match.compare_at_price)}</span><span class="whp-price__sale">${fmt(match.price)}</span><span class="whp-price__badge">-${pct}%</span>`;
      } else {
        priceEl.innerHTML = `<span class="whp-price__current">${fmt(match.price)}</span>`;
      }
    }
  }
  {% endif %}
})();
</script>

{% schema %}
{
  "name": "Hero del producto",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge sobre el título",
      "default": "Parlante de sonidos naturales"
    },
    {
      "type": "textarea",
      "id": "benefits",
      "label": "Beneficios rápidos (separados por |)",
      "default": "🌊 Sonido del mar | 🌧️ Lluvia relajante | 🌿 Naturaleza | 💤 Mejor sueño"
    },
    {
      "type": "textarea",
      "id": "guarantees",
      "label": "Garantías (separadas por |)",
      "default": "🛡️ Garantía 30 días sin preguntas | 🚚 Envío gratis a todo el país | 🔒 Pago 100% seguro"
    }
  ],
  "presets": [
    { "name": "Hero del producto" }
  ]
}
{% endschema %}
