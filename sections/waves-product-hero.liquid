{%- liquid
  assign current_product = product
  assign current_variant = current_product.selected_or_first_available_variant
  assign product_form_id = 'WavesHero-ProductForm-' | append: section.id

  assign can_add_to_cart = false
  assign add_to_cart_text = 'products.product.unavailable' | t
  if current_variant
    if current_variant.available
      assign can_add_to_cart = true
      assign add_to_cart_text = 'products.product.add_to_cart' | t
    elsif current_variant.inventory_quantity <= 0
      assign add_to_cart_text = 'products.product.sold_out' | t
    endif
  endif
-%}

{{ 'base.css' | asset_url | stylesheet_tag }}
{% render 'buy-buttons-styles' %}

<section class="waves-hero-product" id="waves-hero-product">

  <!-- ── Galería de imágenes ── -->
  <div class="whp-gallery">
    {%- if current_product.images.size > 0 -%}
      <div class="whp-gallery__track" id="whp-track">
        {%- for img in current_product.images -%}
          <div class="whp-gallery__slide{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}">
            {{
              img
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                alt: img.alt | default: current_product.title,
                class: 'whp-gallery__img'
            }}
          </div>
        {%- endfor -%}
      </div>

      {%- if current_product.images.size > 1 -%}
        <div class="whp-gallery__thumbs">
          {%- for img in current_product.images -%}
            <button
              class="whp-gallery__thumb{% if forloop.first %} active{% endif %}"
              data-index="{{ forloop.index0 }}"
              aria-label="Imagen {{ forloop.index }}"
            >
              {{
                img
                | image_url: width: 120
                | image_tag:
                  loading: 'lazy',
                  alt: img.alt | default: current_product.title
              }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="whp-gallery__placeholder"></div>
    {%- endif -%}
  </div>

  <!-- ── Panel de compra ── -->
  <div class="whp-panel">
    <div class="whp-panel__inner">

      {%- if section.settings.badge != blank -%}
        <p class="whp-badge">{{ section.settings.badge }}</p>
      {%- endif -%}

      <h1 class="whp-title">{{ current_product.title }}</h1>

      <!-- Precio -->
      <div class="whp-price" id="whp-price">
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="whp-price__original">{{ current_variant.compare_at_price | money }}</span>
          <span class="whp-price__sale">{{ current_variant.price | money }}</span>
          {%- assign savings = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
          <span class="whp-price__badge">-{{ savings }}%</span>
        {%- else -%}
          <span class="whp-price__current">{{ current_variant.price | money }}</span>
        {%- endif -%}
      </div>

      <!-- Beneficios rápidos -->
      {%- if section.settings.benefits != blank -%}
        <div class="whp-benefits">
          {%- assign benefit_list = section.settings.benefits | split: '|' -%}
          {%- for benefit in benefit_list -%}
            <span class="whp-benefit">{{ benefit | strip }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <!-- Separador -->
      <div class="whp-divider"></div>

      <!-- Variantes (si hay más de una) -->
      {%- unless current_product.has_only_default_variant -%}
        <div class="whp-variants">
          {%- for option in current_product.options_with_values -%}
            <div class="whp-variant-group">
              <label class="whp-variant-label">{{ option.name }}</label>
              <div class="whp-variant-btns">
                {%- for value in option.values -%}
                  <label class="whp-variant-btn{% if value.selected %} selected{% endif %}{% unless value.available %} unavailable{% endunless %}">
                    <input
                      type="radio"
                      name="options[{{ option.name | escape }}]"
                      value="{{ value | escape }}"
                      {% if value.selected %}checked{% endif %}
                      {% unless value.available %}disabled{% endunless %}
                    >
                    {{ value | escape }}
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      <!-- Formulario de compra -->
      <product-form-component
        data-section-id="{{ section.id }}"
        data-product-id="{{ current_product.id }}"
        data-product-url="{{ current_product.url }}"
        on:submit="/handleSubmit"
        data-quantity-default="1"
        data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
      >
        <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>

        {%- form 'product', current_product, id: product_form_id, data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" ref="variantId" value="{{ current_variant.id }}">

          <div class="whp-form-actions" ref="productFormButtons">
            <div class="whp-form-error hidden" ref="addToCartTextError">
              <span class="svg-wrapper"></span>
              <span ref="addToCartErrorMessage"></span>
            </div>

            <add-to-cart-component
              ref="addToCartButtonContainer"
              data-product-variant-media="{{ current_variant.featured_media.preview_image | image_url: width: 100 }}"
              data-add-to-cart-animation="{{ settings.add_to_cart_animation }}"
            >
              <button
                type="submit"
                name="add"
                ref="addToCartButton"
                class="whp-cta-btn"
                {% unless can_add_to_cart %}disabled{% endunless %}
              >
                <span class="add-to-cart-text">
                  {%- if can_add_to_cart -%}
                    <span aria-hidden="true" class="svg-wrapper add-to-cart-icon">
                      {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
                    </span>
                  {%- endif -%}
                  <span class="add-to-cart-text__content">
                    <span><span>{{ add_to_cart_text }}</span></span>
                  </span>
                </span>
                <span class="add-to-cart__added">
                  <span class="svg-wrapper add-to-cart__added-icon">
                    {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
                  </span>
                </span>
              </button>
            </add-to-cart-component>
          </div>
        {%- endform -%}
      </product-form-component>

      <!-- Garantías -->
      {%- if section.settings.guarantees != blank -%}
        <div class="whp-guarantees">
          {%- assign guarantee_list = section.settings.guarantees | split: '|' -%}
          {%- for g in guarantee_list -%}
            <div class="whp-guarantee">{{ g | strip }}</div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <!-- Descripción corta -->
      {%- if section.settings.show_description and current_product.description != blank -%}
        <div class="whp-description">
          {{ current_product.description }}
        </div>
      {%- endif -%}

    </div>
  </div>

  <!-- Flecha scroll hint -->
  <div class="whp-scroll-hint" aria-hidden="true">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
      <path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

</section>

<!-- Wave separator: transición del hero oscuro a la siguiente sección -->
<div class="whp-wave-sep" aria-hidden="true">
  <svg viewBox="0 0 1440 72" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0,40 C360,80 1080,0 1440,40 L1440,72 L0,72 Z" fill="var(--color-background, #ffffff)"/>
  </svg>
</div>

<style>
/* ══════════════════════════════════════════════
   WAVES PRODUCT HERO — waves-product-hero.liquid
   ══════════════════════════════════════════════ */
.waves-hero-product {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 90vh;
  background: #0B1F3A;
  overflow: hidden;
}

/* ── Gallery (left column) ── */
.whp-gallery {
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #07172C;
}

.whp-gallery__track {
  flex: 1;
  position: relative;
}

.whp-gallery__slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 0.45s ease;
  pointer-events: none;
}
.whp-gallery__slide.active {
  opacity: 1;
  position: relative;
  pointer-events: auto;
}

.whp-gallery__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

/* Thumbnails */
.whp-gallery__thumbs {
  display: flex;
  gap: 6px;
  padding: 12px;
  overflow-x: auto;
  background: rgba(0,0,0,0.3);
  scrollbar-width: thin;
  scrollbar-color: rgba(255,255,255,0.2) transparent;
}
.whp-gallery__thumb {
  flex-shrink: 0;
  width: 60px;
  height: 60px;
  border-radius: 8px;
  overflow: hidden;
  cursor: pointer;
  border: 2px solid transparent;
  padding: 0;
  background: none;
  opacity: 0.6;
  transition: all 0.2s;
}
.whp-gallery__thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.whp-gallery__thumb.active,
.whp-gallery__thumb:hover {
  border-color: #4FC3F7;
  opacity: 1;
}

/* ── Buy panel (right column) ── */
.whp-panel {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 60px 48px;
  overflow-y: auto;
  background: linear-gradient(160deg, #0B1F3A 0%, #0d2545 100%);
  border-left: 1px solid rgba(255,255,255,0.06);
}
.whp-panel__inner {
  max-width: 480px;
}

/* Badge */
.whp-badge {
  display: inline-block;
  background: rgba(79,195,247,0.15);
  border: 1px solid rgba(79,195,247,0.3);
  color: #4FC3F7;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 100px;
  margin-bottom: 18px;
}

/* Title */
.whp-title {
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 800;
  color: #ffffff;
  line-height: 1.15;
  margin: 0 0 16px;
  font-family: var(--font-primary--family, inherit);
}

/* Price */
.whp-price {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
  flex-wrap: wrap;
}
.whp-price__current {
  font-size: 1.8rem;
  font-weight: 700;
  color: #ffffff;
}
.whp-price__sale {
  font-size: 1.8rem;
  font-weight: 700;
  color: #4FC3F7;
}
.whp-price__original {
  font-size: 1.1rem;
  color: rgba(255,255,255,0.45);
  text-decoration: line-through;
}
.whp-price__badge {
  background: #1B5E20;
  color: #A5D6A7;
  font-size: 0.75rem;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 6px;
}

/* Benefits pills */
.whp-benefits {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 20px;
}
.whp-benefit {
  background: rgba(255,255,255,0.07);
  color: rgba(255,255,255,0.85);
  font-size: 0.8rem;
  font-weight: 500;
  padding: 6px 12px;
  border-radius: 20px;
  border: 1px solid rgba(255,255,255,0.1);
}

/* Divider */
.whp-divider {
  height: 1px;
  background: rgba(255,255,255,0.08);
  margin-bottom: 22px;
}

/* Variants */
.whp-variants {
  margin-bottom: 22px;
}
.whp-variant-group {
  margin-bottom: 14px;
}
.whp-variant-label {
  display: block;
  font-size: 0.82rem;
  font-weight: 600;
  color: rgba(255,255,255,0.6);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 8px;
}
.whp-variant-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.whp-variant-btn {
  cursor: pointer;
  padding: 8px 16px;
  border-radius: 8px;
  border: 1.5px solid rgba(255,255,255,0.2);
  color: rgba(255,255,255,0.8);
  font-size: 0.88rem;
  font-weight: 500;
  transition: all 0.2s;
  user-select: none;
}
.whp-variant-btn input { display: none; }
.whp-variant-btn.selected,
.whp-variant-btn:hover {
  border-color: #4FC3F7;
  color: #4FC3F7;
  background: rgba(79,195,247,0.1);
}
.whp-variant-btn.unavailable {
  opacity: 0.35;
  cursor: not-allowed;
}

/* CTA Button */
.whp-form-actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 20px;
}
.whp-form-error {
  color: #ef5350;
  font-size: 0.85rem;
  display: flex;
  align-items: center;
  gap: 6px;
}
.whp-form-error.hidden { display: none; }

.whp-cta-btn {
  width: 100%;
  padding: 18px 32px;
  background: linear-gradient(135deg, #1565C0, #0D47A1);
  color: #ffffff;
  font-size: 1rem;
  font-weight: 700;
  border: none;
  border-radius: 12px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  transition: all 0.25s ease;
  position: relative;
  overflow: hidden;
  letter-spacing: 0.02em;
  box-shadow: 0 4px 24px rgba(21,101,192,0.4);
}
.whp-cta-btn:hover:not(:disabled) {
  background: linear-gradient(135deg, #1E88E5, #1565C0);
  transform: translateY(-1px);
  box-shadow: 0 8px 32px rgba(21,101,192,0.55);
}
.whp-cta-btn:active:not(:disabled) {
  transform: translateY(0);
}
.whp-cta-btn:disabled {
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.4);
  cursor: not-allowed;
  box-shadow: none;
}
/* Inherit add-to-cart animation states from theme */
.whp-cta-btn .add-to-cart-text {
  display: flex;
  align-items: center;
  gap: 8px;
}
.whp-cta-btn .add-to-cart-icon svg {
  width: 18px;
  height: 18px;
  fill: currentColor;
}
.whp-cta-btn .add-to-cart__added {
  display: none;
}

/* Guarantees */
.whp-guarantees {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 24px;
  padding: 14px 16px;
  background: rgba(255,255,255,0.04);
  border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.07);
}
.whp-guarantee {
  font-size: 0.83rem;
  color: rgba(255,255,255,0.65);
  display: flex;
  align-items: center;
  gap: 6px;
}

/* Description */
.whp-description {
  font-size: 0.9rem;
  color: rgba(255,255,255,0.5);
  line-height: 1.7;
  border-top: 1px solid rgba(255,255,255,0.07);
  padding-top: 16px;
  margin-top: 8px;
}
.whp-description p { margin: 0 0 10px; }

/* Scroll hint */
.whp-scroll-hint {
  position: absolute;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  color: rgba(255,255,255,0.3);
  animation: whp-bounce 2s ease-in-out infinite;
  pointer-events: none;
  z-index: 2;
}
@keyframes whp-bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50%       { transform: translateX(-50%) translateY(6px); }
}

/* ── Responsive ── */
@media (max-width: 900px) {
  .waves-hero-product {
    grid-template-columns: 1fr;
    min-height: auto;
  }
  .whp-gallery {
    height: 55vw;
    min-height: 300px;
    max-height: 480px;
  }
  .whp-gallery__slide {
    position: absolute;
    inset: 0;
  }
  .whp-gallery__slide.active {
    position: absolute;
  }
  .whp-panel {
    padding: 32px 20px 48px;
    border-left: none;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .whp-panel__inner {
    max-width: 100%;
  }
  .whp-scroll-hint {
    display: none;
  }
}
@media (max-width: 480px) {
  .whp-title {
    font-size: 1.6rem;
  }
  .whp-gallery {
    height: 70vw;
  }
}

/* ── Visually hidden (reuse theme utility) ── */
.waves-hero-product .visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
}

/* ── Wave separator ── */
.whp-wave-sep {
  display: block;
  background: #0B1F3A;
  line-height: 0;
  margin-top: -2px;
}
.whp-wave-sep svg {
  width: 100%;
  height: 72px;
  display: block;
}
</style>

<script>
(function(){
  const section = document.getElementById('waves-hero-product');
  if(!section) return;

  // Galería: cambio de imagen al clickear thumbnail
  const thumbs = section.querySelectorAll('.whp-gallery__thumb');
  const slides = section.querySelectorAll('.whp-gallery__slide');

  function setSlide(index){
    slides.forEach((s,i) => s.classList.toggle('active', i === index));
    thumbs.forEach((t,i) => t.classList.toggle('active', i === index));
  }

  thumbs.forEach(btn => {
    btn.addEventListener('click', () => setSlide(+btn.dataset.index));
  });

  // Variant picker: actualizar precio e input hidden al cambiar variante
  const variantInput = section.querySelector('[ref="variantId"]');
  const priceEl = section.querySelector('#whp-price');
  const variantBtns = section.querySelectorAll('.whp-variant-btn');

  {% if current_product.variants.size > 1 %}
  const variants = {{ current_product.variants | json }};

  variantBtns.forEach(btn => {
    btn.querySelector('input')?.addEventListener('change', () => {
      variantBtns.forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      updateVariant();
    });
  });

  function getSelectedOptions(){
    const opts = {};
    section.querySelectorAll('.whp-variants input[type="radio"]:checked').forEach(r => {
      const name = r.name.replace('options[','').replace(']','');
      opts[name] = r.value;
    });
    return opts;
  }

  function updateVariant(){
    const opts = getSelectedOptions();
    const match = variants.find(v =>
      v.options.every((opt, i) => opt === opts[Object.keys(opts)[i]])
    );
    if(!match) return;
    if(variantInput) variantInput.value = match.id;

    // Actualizar precio
    if(priceEl && match.price){
      const price = (match.price / 100).toLocaleString('es-AR', {style:'currency', currency:'ARS'});
      if(match.compare_at_price && match.compare_at_price > match.price){
        const orig = (match.compare_at_price / 100).toLocaleString('es-AR', {style:'currency', currency:'ARS'});
        const pct = Math.round((match.compare_at_price - match.price) * 100 / match.compare_at_price);
        priceEl.innerHTML = `<span class="whp-price__original">${orig}</span><span class="whp-price__sale">${price}</span><span class="whp-price__badge">-${pct}%</span>`;
      } else {
        priceEl.innerHTML = `<span class="whp-price__current">${price}</span>`;
      }
    }

    // Actualizar estado del botón
    const btn = section.querySelector('.whp-cta-btn');
    if(btn) btn.disabled = !match.available;
  }
  {% endif %}
})();
</script>

{% schema %}
{
  "name": "Hero del producto",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge sobre el título",
      "default": "Parlante de sonidos naturales"
    },
    {
      "type": "textarea",
      "id": "benefits",
      "label": "Beneficios rápidos (separados por |)",
      "default": "🌊 Sonido del mar | 🌧️ Lluvia relajante | 🌿 Naturaleza | 💤 Mejor sueño"
    },
    {
      "type": "textarea",
      "id": "guarantees",
      "label": "Garantías / Trust badges (separados por |)",
      "default": "🛡️ Garantía 30 días sin preguntas | 🚚 Envío gratis a todo el país | 🔒 Pago 100% seguro"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Mostrar descripción del producto",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Hero del producto"
    }
  ]
}
{% endschema %}
